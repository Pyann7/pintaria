# Salin variabel ini ke menu Settings > Environment Variables di Dashboard Vercel
# Atau simpan sebagai file .env.local jika menjalankan `vercel dev` di lokal

GROQ_API_KEY=gsk_isi_api_key_groq_anda_disini
GEMINI_API_KEY=AIzaSy_isi_api_key_gemini_anda_disini

# Prioritas utama ('groq' atau 'gemini'). Jika utama gagal, otomatis beralih ke cadangan.
PRIMARY_AI=groq
